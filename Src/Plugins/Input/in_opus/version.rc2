/////////////////////////////////////////////////////////////////////////////
//
// Version
//
#include "../../../Winamp/buildType.h" // Assuming this path is correct

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0 // Opus plugin initial version
 PRODUCTVERSION WINAMP_PRODUCTVER // Inherit from main Winamp product version
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // English (US), Unicode
        BEGIN
            VALUE "CompanyName", "Winamp SA & Community"
            VALUE "FileDescription", "Opus Input Plugin for Winamp"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "in_opus"
            VALUE "LegalCopyright", "Copyright © 2024 Winamp SA & Community Contributors"
            VALUE "LegalTrademarks", "Nullsoft and Winamp are trademarks of Winamp SA"
            VALUE "OriginalFilename", "in_opus.dll"
            VALUE "ProductName", "Winamp Opus Plugin"
            VALUE "ProductVersion", STR_WINAMP_PRODUCTVER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200 // English (US), Unicode
    END
END
